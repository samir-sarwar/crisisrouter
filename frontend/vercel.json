{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://<your-railway-backend-url>/api/:path*"
        },
        {
            "source": "/oauth2/:path*",
            "destination": "https://<your-railway-backend-url>/oauth2/:path*"
        },
        {
            "source": "/login/oauth2/:path*",
            "destination": "https://<your-railway-backend-url>/login/oauth2/:path*"
        },
        {
            "source": "/logout",
            "destination": "https://<your-railway-backend-url>/logout"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}